    {
      "block_idx": 13,
      "type": "PHASE",
      "head": "PHASE 04 · 消费不是敌人，失去选择才是",
      "voice_chars": 0,
      "subtitles": [],
      "beats": [
        {
          "beat_idx": 0,
          "shot": "wide",
          "visual_description": "城市消费橱窗的明暗交替，年轻上班族停下脚步，把购物袋放下并拿出自己的需求清单。",
          "sentence_ids": [],
          "start_char": 0,
          "end_char": 0,
          "character_ids": [
