      "head": "PHASE 02 · 先画钱流地图，不急着砍掉一杯咖啡",
      "voice_chars": 0,
      "subtitles": [],
      "beats": [
        {
          "beat_idx": 0,
          "shot": "wide",
          "visual_description": "由工资单、房租、订阅和购物袋组成的钱流长廊，年轻上班族带着笔记本走入其中。",
          "sentence_ids": [],
