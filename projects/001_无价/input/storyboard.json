          "emotion": "uncertain",
          "segment": "hook"
        },
        {
          "beat_idx": 3,
          "shot": "medium",
          "visual_description": "天价菜、划线价与首次报价化成三个路标，指向人物接下来的比较方向。",
          "sentence_ids": [
            8
