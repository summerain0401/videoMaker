            4
          ],
          "start_char": 64,
          "end_char": 154,
          "character_ids": [
            "young_pro"
          ],
          "emotion": "reflective",
          "segment": "hook"
        },
        {
          "beat_idx": 2,
          "shot": "close",
          "visual_description": "人物抱着并不需要的购物袋离开，身后巨大的折扣符号逐渐消散。",
          "sentence_ids": [
            5
          ],
          "start_char": 154,
          "end_char": 187,
          "character_ids": [
