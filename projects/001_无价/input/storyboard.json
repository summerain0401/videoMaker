      "voice_chars": 0,
      "subtitles": [],
      "beats": [
        {
          "beat_idx": 0,
          "shot": "wide",
          "visual_description": "价格心理与真实品质之间架起一座桥，两位消费者从怀疑一切走向核对证据。",
