      "head": "PHASE 02 · 锚点怎样改变价值感",
      "voice_chars": 0,
      "subtitles": [],
      "beats": [
        {
          "beat_idx": 0,
          "shot": "wide",
          "visual_description": "雾中道路只有第一盏路灯最醒目，年轻上班族从这盏灯开始辨认方向。",
          "sentence_ids": [],
          "start_char": 0,
          "end_char": 0,
          "character_ids": [
