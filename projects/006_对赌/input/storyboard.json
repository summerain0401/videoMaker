      "voice_chars": 153,
      "subtitles": [
        {
          "id": 0,
          "text": "复盘时可以问：我遗漏了哪条本可获得的信息？",
          "start_char": 0,
          "end_char": 21
        },
        {
          "id": 1,
          "text": "我是否高估了某项能力，或低估了某种成本？",
