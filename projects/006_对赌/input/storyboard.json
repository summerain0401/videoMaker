          "segment": "action"
        },
        {
          "beat_idx": 2,
          "shot": "medium",
          "visual_description": "家庭餐桌上朋友交换建议，主角低头核对自己的时间与储备；画面呼应：“分清以后，你就知道该继续调查，还是该设计一次小行动去验证”",
          "sentence_ids": [
            5
          ],
          "start_char": 110,
          "end_char": 139,
          "character_ids": [
            "frugal_girl"
          ],
